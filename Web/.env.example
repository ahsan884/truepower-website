# SMTP configuration for the contact form (GoDaddy Professional Email).
# Copy this file to .env.local and fill in SMTP_PASS.
# .env.local is gitignored — never commit real credentials.

# GoDaddy Professional Email outgoing (SMTP) server.
SMTP_HOST=smtpout.secureserver.net

# 465 = implicit TLS (used with SMTP_SECURE=true).
SMTP_PORT=465

# "true" for port 465 (implicit TLS), "false" for port 587 (STARTTLS).
SMTP_SECURE=true

# Full mailbox address used to authenticate with the SMTP server.
SMTP_USER=waqas@trupowerpk.com

# Password for that mailbox. Never commit this — set it only in .env.local
# and in the Vercel Environment Variables dashboard.
SMTP_PASS=

# Address contact form submissions are sent to.
CONTACT_TO_EMAIL=waqas@trupowerpk.com

# The "From" address used when sending.
CONTACT_FROM_EMAIL=waqas@trupowerpk.com
